@baseUrl = http://localhost:8080
@reservationId = 1
@reservationWithoutPrimaryGuestId = {{reservationWithoutPrimaryGuestId}}
@token = {{token}}

### Default format: PDF
GET {{baseUrl}}/api/reservations/{{reservationId}}/registration-card
Authorization: Bearer {{token}}
Accept: application/pdf

> {%
    client.test("Returns a PDF registration card by default", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.headers.valueOf("Content-Type").includes("application/pdf"), "Expected PDF content type");
        client.assert(response.headers.valueOf("Content-Disposition").includes("registration-card-" + client.global.get("reservationId") + ".pdf"), "Expected PDF filename");
    });
%}

### Download Word DOCX
GET {{baseUrl}}/api/reservations/{{reservationId}}/registration-card?format=DOCX
Authorization: Bearer {{token}}
Accept: application/vnd.openxmlformats-officedocument.wordprocessingml.document

> {%
    client.test("Returns Word DOCX", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.headers.valueOf("Content-Type").includes("application/vnd.openxmlformats-officedocument.wordprocessingml.document"), "Expected DOCX content type");
    });
%}

### Preview guest registration card (rendered page, no PDF viewer chrome)
GET {{baseUrl}}/api/reservations/{{reservationId}}/registration-card/preview
Authorization: Bearer {{token}}
Accept: image/png

> {%
    client.test("Returns a clean PNG preview", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.headers.valueOf("Content-Type").includes("image/png"), "Expected PNG preview");
    });
%}

### Download Excel XLSX
GET {{baseUrl}}/api/reservations/{{reservationId}}/registration-card?format=XLSX
Authorization: Bearer {{token}}
Accept: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

> {%
    client.test("Returns Excel XLSX", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.headers.valueOf("Content-Type").includes("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"), "Expected XLSX content type");
    });
%}

### Missing reservation should return 404
GET {{baseUrl}}/api/reservations/999999999/registration-card
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Missing reservation returns 404", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

### Reservation without a primary guest should return 400
GET {{baseUrl}}/api/reservations/{{reservationWithoutPrimaryGuestId}}/registration-card
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Missing primary guest returns a validation error", function () {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.message.includes("основного гостя"), "Expected primary guest error message");
    });
%}
