
@baseUrl = http://localhost:8080
@categoryId = {{createdCategoryId}}
@rateId = {{createdRateId}}

### 1. CREATE RATE

POST {{baseUrl}}/api/rates
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Test Rate",
  "description": "Rate created for API testing",
  "currency": "UAH",
  "categoryId": "{{categoryId}}",
  "active": true,
  "breakfastIncluded": false
}

> {%
    client.global.set("createdRateId", response.body.id);
%}

###

### 2. GET ALL RATES

GET {{baseUrl}}/api/rates
Authorization: Bearer {{token}}

###

### 3. GET RATE BY ID

GET {{baseUrl}}/api/rates/{{rateId}}
Authorization: Bearer {{token}}

###

### 4. UPDATE RATE

PUT {{baseUrl}}/api/rates/{{rateId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Test Rate Updated",
  "description": "Updated rate description",
  "currency": "UAH",
  "categoryId": "{{categoryId}}",
  "active": true,
  "breakfastIncluded": true
}
