  "checkOutTime": "12:00"
}
###
POST {{roomUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomNumber": "102",
  "floor": 1,
  "status": "AVAILABLE",
  "roomView": "CITY",
  "hotelId": {{hotelId}},
  "categoryId": {{standardCategoryId}}
}