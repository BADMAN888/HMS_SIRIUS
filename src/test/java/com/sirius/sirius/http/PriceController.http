
@baseUrl = http://localhost:8080
@documentId = {{createdDocumentId}}

### 1. CREATE GUEST DOCUMENT

POST {{baseUrl}}/api/guest-documents
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "documentType": "PASSPORT",
  "documentNumber": "HTTP123456",
  "issuedBy": "Test Authority",
  "issueDate": "2020-01-15",
  "expirationDate": "2030-01-15"
}

> {%
    client.global.set("createdDocumentId", response.body.id);
%}

###

### 2. GET ALL GUEST DOCUMENTS

GET {{baseUrl}}/api/guest-documents
Authorization: Bearer {{token}}

###

### 3. GET GUEST DOCUMENT BY ID

GET {{baseUrl}}/api/guest-documents/{{documentId}}
Authorization: Bearer {{token}}

###

### 4. UPDATE GUEST DOCUMENT

PUT {{baseUrl}}/api/guest-documents/{{documentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "documentType": "PASSPORT",
  "documentNumber": "HTTP654321",
  "issuedBy": "Updated Test Authority",
  "issueDate": "2021-02-10",
  "expirationDate": "2031-02-10"
}

###

### 5. DELETE GUEST DOCUMENT

DELETE {{baseUrl}}/api/guest-documents/{{documentId}}
Authorization: Bearer {{token}}
