
@baseUrl = http://localhost:8080
@priceUrl = {{baseUrl}}/api/prices
@rateId = 1
@priceDate = 2099-01-15

### ========================================
### LOGIN
### ========================================

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.global.set("token", response.body.token);
%}


### ========================================
### CREATE PRICE
### ========================================

POST {{priceUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rateId": {{rateId}},
  "price": 5000.00,
  "validFrom": "{{priceDate}}",
  "validTo": "2099-12-31"
}

> {%
    client.test("Create price - status 201", function() {
        client.assert(response.status === 201, "Expected status 201");
    });

    client.test("Create price - ID exists", function() {
        client.assert(response.body.id !== undefined, "ID is missing");
    });

    client.test("Create price - rate ID is correct", function() {
        client.assert(response.body.rateId === 1, "Rate ID is incorrect");
    });

    client.test("Create price - price is correct", function() {
        client.assert(Number(response.body.price) === 5000, "Price is incorrect");
    });

    client.global.set("priceId", response.body.id);
%}


### ========================================
### GET PRICE HISTORY BY RATE
### ========================================

GET {{priceUrl}}/rate/{{rateId}}
Authorization: Bearer {{token}}

> {%
    client.test("Get price history - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Get price history - response is array", function() {
        client.assert(Array.isArray(response.body), "Response is not an array");
    });
%}


### ========================================
### GET PRICE FOR DATE
### ========================================

GET {{priceUrl}}/rate/{{rateId}}/date/{{priceDate}}
Authorization: Bearer {{token}}

> {%
    client.test("Get price for date - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Get price for date - correct rate", function() {
        client.assert(response.body.rateId === 1, "Rate ID is incorrect");
    });

    client.test("Get price for date - correct amount", function() {
        client.assert(Number(response.body.price) === 5000, "Price is incorrect");
    });
%}


### ========================================
### CREATE PRICE - RATE NOT FOUND
### ========================================

POST {{priceUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "rateId": 999999,
  "price": 5000.00,
  "validFrom": "2099-01-15",
  "validTo": "2099-12-31"
}

> {%
    client.test("Create price with missing rate - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


