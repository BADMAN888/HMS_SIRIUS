
@baseUrl = http://localhost:8080

@hotelId = {{createdHotelId}}
@facilityId = {{createdFacilityId}}
@reservationId = {{createdReservationId}}
@profileId = {{createdProfileId}}
@folioId = {{createdFolioId}}
@accrualId = {{createdAccrualId}}

### 1. CREATE ACCRUAL

POST {{baseUrl}}/api/accruals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "facilityId": {{facilityId}},
  "reservationId": {{reservationId}},
  "recipientId": {{profileId}},
  "folioId": {{folioId}},
  "serviceDate": "2026-11-15",
  "quantity": 1
}

> {%
    client.test("Accrual created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Accrual ID is missing");
    });

    client.global.set("createdAccrualId", response.body.id);
%}

###

### 2. GET ALL ACCRUALS

GET {{baseUrl}}/api/accruals
Authorization: Bearer {{token}}

###

### 3. GET ACCRUAL BY ID

GET {{baseUrl}}/api/accruals/{{accrualId}}
Authorization: Bearer {{token}}

###

### 4. GET ACCRUALS BY FOLIO

GET {{baseUrl}}/api/accruals/folio/{{folioId}}
Authorization: Bearer {{token}}

###

### 5. GET UNASSIGNED ACCRUALS BY HOTEL

GET {{baseUrl}}/api/accruals/hotel/{{hotelId}}/unassigned
Authorization: Bearer {{token}}

###

### 6. GET UNASSIGNED ACCRUALS BY RESERVATION

GET {{baseUrl}}/api/accruals/reservation/{{reservationId}}/unassigned
Authorization: Bearer {{token}}

###

### 7. DELETE ACCRUAL

DELETE {{baseUrl}}/api/accruals/{{accrualId}}
Authorization: Bearer {{token}}
