###

### Create reservation comment
POST {{reservationUrl}}/{{reservationId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість попросив підготувати номер до заїзду."
}

> {%
    client.test("Comment created", function () {
        client.assert(response.status === 201);
    });
    client.global.set("commentId", response.body.id);
%}

###

### Update reservation comment
PUT {{reservationUrl}}/{{reservationId}}/comments/{{commentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість підтвердив пізній час прибуття."
}

> {%
    client.test("Comment updated", function () {
        client.assert(response.status === 200);
    });
    client.test("Comment text updated", function () {
        client.assert(response.body.text === "Гість підтвердив пізній час прибуття.");
    });
%}

###

### Delete reservation comment
DELETE {{reservationUrl}}/{{reservationId}}/comments/{{commentId}}
Authorization: Bearer {{token}}

> {%
    client.test("Comment deleted", function () {
        client.assert(response.status === 204);
    });
%}

###

### Cancel reservation
PATCH {{reservationUrl}}/{{reservationId}}/cancel
Authorization: Bearer {{token}}

> {%
    client.test("Reservation cancelled", function () {
        client.assert(response.status === 204);
    });
%}

###

### Verify reservation is cancelled
GET {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}

> {%
    client.test("Reservation status is CANCELLED", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status === "CANCELLED");
    });
%}
