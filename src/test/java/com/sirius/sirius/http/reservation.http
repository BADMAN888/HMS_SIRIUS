### Create reservation for overlap test
POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-12-01T14:00:00",
  "checkOut": "2026-12-05T12:00:00",
  "adults": 1,
  "children": 0,
  "externalBookingNumber": "EXT-OVERLAP-01",
  "bookingSource": "DIRECT",
  "company": "Olga Travel",
  "operatorCompany": "Sirius Operator"
}

> {%
    client.test("Overlap test reservation created", function () {
        client.assert(response.status === 201);
    });
    client.global.set("overlapReservationId", response.body.id);
%}

