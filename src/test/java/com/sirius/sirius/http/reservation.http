###

### Create reservation comment

POST {{reservationUrl}}/{{reservationId}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість попросив підготувати номер до заїзду."
}


###

### Get comments after creating one

GET {{reservationUrl}}/{{reservationId}}/comments
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("Created comment exists", function () {
        var commentId = client.global.get("commentId");

        client.assert(response.body.some(function (comment) {
            return comment.id == commentId;
        }));
    });
%}

###

### Update reservation comment

PUT {{reservationUrl}}/{{reservationId}}/comments/{{commentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість підтвердив пізній час прибуття."
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Comment text was updated", function () {
        client.assert(response.body.text === "Гість підтвердив пізній час прибуття.");
    });

    client.test("Comment id remains the same", function () {
        client.assert(response.body.id == client.global.get("commentId"));
    });

    client.test("Reservation id is correct", function () {
        client.assert(response.body.reservationId == client.global.get("reservationId"));
    });
%}

