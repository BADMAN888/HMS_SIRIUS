@baseUrl = http://localhost:8080
@reservationUrl = {{baseUrl}}/api/reservations

@roomId = 1
@rateId = 1
@guestId = 1

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200);
    });
    client.global.set("token", response.body.accessToken ?? response.body.token);
%}


### Create reservation
POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-11-10T14:00:00",
  "checkOut": "2026-11-12T12:00:00",
  "adults": 2,
  "children": 0,
  "externalBookingNumber": "EXT-TEST-1001",
  "bookingSource": "BOOKING_COM",
  "company": "Olga Travel",
  "operatorCompany": "Sirius Operator"
}


### Get reservation by id
GET {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}

> {%
    client.test("Reservation loaded", function () {
        client.assert(response.status === 200);
    });
    client.test("Reservation status is CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });
    client.test("External booking data returned", function () {
        client.assert(response.body.externalBookingNumber === "EXT-TEST-1001");
        client.assert(response.body.bookingSource === "BOOKING_COM");
        client.assert(response.body.company === "Olga Travel");
        client.assert(response.body.operatorCompany === "Sirius Operator");
    });
%}

###

### Get all reservations
GET {{reservationUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Reservations loaded", function () {
        client.assert(response.status === 200);
    });
    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

###

### Get reservations by status
GET {{reservationUrl}}/status/CONFIRMED
Authorization: Bearer {{token}}

> {%
    client.test("Confirmed reservations loaded", function () {
        client.assert(response.status === 200);
    });
    client.test("All returned reservations are CONFIRMED", function () {
        response.body.forEach(function (reservation) {
            client.assert(reservation.status === "CONFIRMED");
        });
    });
%}

###

### Update reservation
PUT {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-11-11T14:00:00",
  "checkOut": "2026-11-13T12:00:00",
  "adults": 2,
  "children": 0,
  "externalBookingNumber": "EXT-TEST-1002",
  "bookingSource": "DIRECT",
  "company": "Olga Travel Updated",
  "operatorCompany": "Sirius Operator Updated"
}

> {%
    client.test("Reservation updated", function () {
        client.assert(response.status === 200);
    });
    client.test("External booking fields updated", function () {
        client.assert(response.body.externalBookingNumber === "EXT-TEST-1002");
        client.assert(response.body.bookingSource === "DIRECT");
        client.assert(response.body.company === "Olga Travel Updated");
        client.assert(response.body.operatorCompany === "Sirius Operator Updated");
    });
%}

