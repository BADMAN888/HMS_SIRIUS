### Invalid check-out
POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-11-20T14:00:00",
  "checkOut": "2026-11-15T12:00:00",
  "adults": 2,
  "children": 0,
  "externalBookingNumber": "EXT-INVALID-01",
  "bookingSource": "DIRECT",
  "company": "Olga Travel",
  "operatorCompany": "Sirius Operator"
}

> {%
    client.test("Invalid date range rejected", function () {
        client.assert(response.status === 400);
    });
%}

