@baseUrl = http://localhost:8080
@reservationUrl = {{baseUrl}}/api/reservations

@roomId = 1
@rateId = 1
@guestId = 1

### Login

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.global.set("token", response.body.accessToken ?? response.body.token);
%}

###

### Create reservation

POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-11-10T14:00:00",
  "checkOut": "2026-11-12T12:00:00",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Status is 201", function () {
        client.assert(response.status === 201);
    });

    client.test("Check-in is correct", function () {
        client.assert(response.body.checkIn === "2026-11-10T14:00:00");
    });

    client.test("Check-out is correct", function () {
        client.assert(response.body.checkOut === "2026-11-12T12:00:00");
    });

    client.global.set("reservationId", response.body.id);
%}

###

### Get reservation by id

GET {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Correct reservation id", function () {
        client.assert(response.body.id == client.global.get("reservationId"));
    });

    client.test("Status is CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });

    client.test("Check-in is correct", function () {
        client.assert(response.body.checkIn === "2026-11-10T14:00:00");
    });

    client.test("Check-out is correct", function () {
        client.assert(response.body.checkOut === "2026-11-12T12:00:00");
    });
%}

###

### Get all reservations

GET {{reservationUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

###

### Get reservations by status

GET {{reservationUrl}}/status/CONFIRMED
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("All reservations are CONFIRMED", function () {
        response.body.forEach(function (reservation) {
            client.assert(reservation.status === "CONFIRMED");
        });
    });
%}

###

### Update reservation

PUT {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "primaryGuestId": {{guestId}},
  "guestIds": [{{guestId}}],
  "checkIn": "2026-11-11T14:00:00",
  "checkOut": "2026-11-13T12:00:00",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Check-in was updated", function () {
        client.assert(response.body.checkIn === "2026-11-11T14:00:00");
    });

    client.test("Check-out was updated", function () {
        client.assert(response.body.checkOut === "2026-11-13T12:00:00");
    });

    client.test("Status remains CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });
%}

