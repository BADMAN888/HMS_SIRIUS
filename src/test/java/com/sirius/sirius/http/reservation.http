###

### Get reservations by check-in date

GET {{reservationUrl}}/check-in?date=2026-12-01
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("Response contains totalAmount when non-empty", function () {
        if (response.body.length > 0) {
            client.assert(response.body[0].totalAmount !== undefined);
        }
    });

    client.test("Response contains roomId when non-empty", function () {
        if (response.body.length > 0) {
            client.assert(response.body[0].roomId !== undefined);
        }
    });
%}

