@baseUrl = http://localhost:8080
@reservationUrl = {{baseUrl}}/api/reservations

@roomId = 1
@rateId = 1

### Login

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.global.set("token", response.body.token);
%}

###

### Create reservation

POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "guest": {
    "firstName": "John",
    "lastName": "Smith",
    "phone": "+380501234567"
  },
  "checkInDate": "2026-10-10",
  "checkOutDate": "2026-10-15",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Status is 201", function () {
        client.assert(response.status === 201);
    });

    client.test("Reservation has id", function () {
        client.assert(response.body.id !== undefined);
    });

    client.test("Confirmation number exists", function () {
        client.assert(response.body.confirmationNumber !== undefined);
    });

    client.test("Status is CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });

    client.test("Room id is correct", function () {
        client.assert(response.body.roomId == client.global.get("roomId"));
    });

    client.test("Rate id is correct", function () {
        client.assert(response.body.rateId == client.global.get("rateId"));
    });

    client.test("Guest ids exist", function () {
        client.assert(Array.isArray(response.body.guestIds));
        client.assert(response.body.guestIds.length === 1);
    });

    client.test("Folio exists", function () {
        client.assert(
            response.body.folioId !== undefined &&
            response.body.folioId !== null
        );
    });

    client.global.set("reservationId", response.body.id);
%}

###

### Get reservation by id

GET {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Correct reservation id", function () {
        client.assert(response.body.id == client.global.get("reservationId"));
    });

    client.test("Status is CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });
%}

###

### Get all reservations

GET {{reservationUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

###

### Update reservation

PUT {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{roomId}},
  "rateId": {{rateId}},
  "guest": {
    "firstName": "John",
    "lastName": "Smith Updated",
    "phone": "+380501234568"
  },
  "checkInDate": "2026-10-11",
  "checkOutDate": "2026-10-16",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Dates were updated", function () {
        client.assert(response.body.checkInDate === "2026-10-11");
        client.assert(response.body.checkOutDate === "2026-10-16");
    });

    client.test("Status remains CONFIRMED", function () {
        client.assert(response.body.status === "CONFIRMED");
    });
%}

