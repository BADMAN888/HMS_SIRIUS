### Cancel reservation

PATCH {{reservationUrl}}/{{reservationId}}/cancel
Authorization: Bearer {{token}}

> {%
    client.test("Status is 204", function () {
        client.assert(response.status === 204);
    });
%}

###

### Verify reservation is cancelled

GET {{reservationUrl}}/{{reservationId}}
Authorization: Bearer {{token}}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Status is CANCELLED", function () {
        client.assert(response.body.status === "CANCELLED");
    });
%}

###

