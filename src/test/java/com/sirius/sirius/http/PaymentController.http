
@baseUrl = http://localhost:8080

@folioId = {{createdFolioId}}
@paymentId = {{createdPaymentId}}

### 1. CREATE PAYMENT

POST {{baseUrl}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "folioId": {{folioId}},
  "method": "CASH",
  "amount": 1000.00,
  "description": "HTTP test payment"
}

> {%
    client.test("Payment created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Payment ID is missing");
    });

    client.global.set("createdPaymentId", response.body.id);
%}

###

### 2. GET ALL PAYMENTS

GET {{baseUrl}}/api/payments
Authorization: Bearer {{token}}

###

### 3. GET PAYMENT BY ID

GET {{baseUrl}}/api/payments/{{paymentId}}
Authorization: Bearer {{token}}

###

### 4. GET PAYMENTS BY FOLIO

GET {{baseUrl}}/api/payments/folio/{{folioId}}
Authorization: Bearer {{token}}

###

### 5. REFUND PAYMENT

POST {{baseUrl}}/api/payments/{{paymentId}}/refund
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 100.00,
  "reason": "HTTP test refund"
}

