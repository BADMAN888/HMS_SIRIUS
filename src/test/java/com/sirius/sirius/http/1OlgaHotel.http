### GET ALL RATES

GET {{rateUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("All eight BAR rates loaded", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body));
        var expectedRates = ["BAR-RO ", "BAR-BB ", "BAR-RO5 ", "BAR-BB5 ", "BAR-RO10 ", "BAR-BB10 ", "BAR-RO15 ", "BAR-BB15 "];
        expectedRates.forEach(function (rateName) {
            client.assert(response.body.some(function (rate) {
                return rate.name === rateName + client.global.get("runCode");
            }), "Missing rate: " + rateName);
        });
    });
%}
