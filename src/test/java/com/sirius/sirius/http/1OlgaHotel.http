### RESERVATIONS ON 2026-09-25

GET {{reservationUrl}}/date?date=2026-09-25
Authorization: Bearer {{token}}

> {%
    client.test("Reservations on 2026-09-25 loaded", function () {
        client.assert(response.status === 200);
    });

    client.assert(response.body.length === 4);

    const reservationIds = response.body.map(
        reservation => reservation.id
    );

    client.assert(
        reservationIds.includes(
            client.global.get("reservation1Id")
        )
    );

    client.assert(
        reservationIds.includes(
            client.global.get("reservation2Id")
        )
    );

    client.assert(
        reservationIds.includes(
            client.global.get("reservation3Id")
        )
    );

    client.assert(
        reservationIds.includes(
            client.global.get("reservation5Id")
        )
    );
%}


