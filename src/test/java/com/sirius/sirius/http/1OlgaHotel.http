### ==================================================
### 7. VERIFICATION
### ==================================================

### Get hotel

GET {{hotelUrl}}/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Correct hotel id", function () {
        client.assert(response.body.id == client.global.get("hotelId"));
    });
%}

### Get all hotels

GET {{hotelUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotels GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Hotels response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

### Get all room categories

GET {{roomCategoryUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Room categories GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Room categories response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

### Get all rooms

GET {{roomUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Rooms GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Rooms response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

### Get BAR rate

GET {{rateUrl}}/{{barRateId}}
Authorization: Bearer {{token}}

> {%
    client.test("BAR rate GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Rate name is BAR", function () {
        client.assert(response.body.name === "BAR");
    });

    client.test("Rate currency is UAH", function () {
        client.assert(response.body.currency === "UAH");
    });

    client.test("Rate is active", function () {
        client.assert(response.body.active === true);
    });
%}

### Get all rates

GET {{rateUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Rates GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Rates response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}

### Get BAR Standard price

GET {{priceUrl}}/{{barStandardPriceId}}
Authorization: Bearer {{token}}

> {%
    client.test("Price GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Price is correct", function () {
        client.assert(response.body.price == 5000);
    });

    client.test("Price status is ACTIVE", function () {
        client.assert(response.body.status === "ACTIVE");
    });

    client.test("Price has correct category", function () {
        client.assert(
            response.body.roomCategoryId == client.global.get("standardCategoryId")
        );
    });
%}

### Get all prices

GET {{priceUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Prices GET status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Prices response is array", function () {
        client.assert(Array.isArray(response.body));
    });
%}