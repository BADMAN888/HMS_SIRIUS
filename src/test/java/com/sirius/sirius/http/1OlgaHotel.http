
@baseUrl = http://localhost:8080

@hotelUrl = {{baseUrl}}/api/hotels
@roomCategoryUrl = {{baseUrl}}/api/room-category
@roomUrl = {{baseUrl}}/api/rooms
@rateUrl = {{baseUrl}}/api/rates
@priceUrl = {{baseUrl}}/api/prices
@profileUrl = {{baseUrl}}/api/profiles
@guestDocumentUrl = {{baseUrl}}/api/guest-documents
@companyUrl = {{baseUrl}}/api/companies
@facilityUrl = {{baseUrl}}/api/facilities
@facilityPriceUrl = {{baseUrl}}/api/facility-prices
@reservationUrl = {{baseUrl}}/api/reservations
@folioUrl = {{baseUrl}}/api/folios
@accrualUrl = {{baseUrl}}/api/accruals
@paymentUrl = {{baseUrl}}/api/payments
@balanceAccountUrl = {{baseUrl}}/api/balance-accounts
@correctionUrl = {{baseUrl}}/api/reservation-financial-corrections
@hotelGridUrl = {{baseUrl}}/api/hotel-grid

### ==================================================
### TEST CONFIGURATION
### ==================================================

@runCode = 61110001

### Бронювання 1
@reservation1CheckInDate = 2026-11-20
@reservation1CheckOutDate = 2026-11-23

### Бронювання 2
@reservation2CheckInDate = 2026-11-22
@reservation2CheckOutDate = 2026-11-24

### Бронювання 3
@reservation3CheckInDate = 2026-11-25
@reservation3CheckOutDate = 2026-11-27

### Період дії тарифів
@priceValidFrom = 2026-01-01
@priceValidTo = 2030-12-31

### ==================================================
### AUTH
### ==================================================

### LOGIN

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "http-test@sirius.com",
  "password": "TestPassword123!"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200);
    });

    client.test("Access token exists", function () {
        client.assert(response.body.token !== null);
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
%}

###

### REFRESH TOKEN

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Token refreshed", function () {
        client.assert(response.status === 200);
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### ==================================================
### HOTEL
### ==================================================

### CREATE HOTEL

POST {{hotelUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "Sirius Riverside Hotel {{runCode}}",
  "description": "End-to-end test hotel",
  "phone": "+380671112233",
  "email": "sirius.{{runCode}}@gmail.com",
  "address": "Kozyn, Kyiv Oblast, Ukraine",
  "checkInTime": "14:00:00",
  "checkOutTime": "12:00:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("hotelId", response.body.id);
%}

###

### GET HOTEL

GET {{hotelUrl}}/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel loaded", function () {
        client.assert(response.status === 200);
    });
%}

###

### GET HOTEL BY NAME

GET {{hotelUrl}}/by-name?name=Sirius%20Riverside%20Hotel%20{{runCode}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel found by name", function () {
        client.assert(response.status === 200);
    });
%}

