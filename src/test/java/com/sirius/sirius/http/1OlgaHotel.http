###

### SCHEDULE ROOM 101 OUT OF SERVICE

POST {{baseUrl}}/api/room-unavailabilities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{room1Id}},
  "status": "OUT_OF_SERVICE",
  "startAt": "2026-01-01T00:00:00",
  "endAt": "2026-01-10T00:00:00",
  "reason": "HTTP integration out of service scenario"
}

> {%
    client.test("Room can be scheduled out of service", function () {
        client.assert(response.status === 201);
        client.assert(response.body.status === "OUT_OF_SERVICE");
    });
    client.global.set("roomOutOfServiceId", response.body.id);
%}

###

### FINISH ROOM 101 OUT OF SERVICE

PATCH {{baseUrl}}/api/room-unavailabilities/{{roomOutOfServiceId}}/finish
Authorization: Bearer {{token}}

> {%
    client.test("Room out of service can be completed", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status === "OUT_OF_SERVICE");
        client.assert(response.body.completedAt !== null);
    });
%}

