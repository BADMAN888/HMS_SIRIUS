Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість підтвердив прибуття після 20:00."
}

> {%
    client.test("Comment updated", function () {
        client.assert(response.status === 200);
    });

    client.test("Updated text is correct", function () {
