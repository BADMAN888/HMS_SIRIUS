### VERIFY COMMENT DELETED

GET {{reservationUrl}}/{{reservation1Id}}/comments
Authorization: Bearer {{token}}

> {%
    client.test("Comments loaded after deletion", function () {
        client.assert(response.status === 200);
    });

    const commentId = client.global.get("reservationCommentId");

    client.test("Deleted comment is absent", function () {
        client.assert(!response.body.some(function (comment) {
            return comment.id == commentId;
        }));
    });
%}

