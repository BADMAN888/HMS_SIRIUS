###

### CREATE RESERVATION 1 - STANDARD

POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{room101Id}},
  "rateId": {{barStandardRateId}},
  "primaryGuestId": {{profile1Id}},
  "guestIds": [{{profile1Id}}, {{profile2Id}}],
  "checkIn": "2026-10-20T14:00:00",
  "checkOut": "2026-10-22T12:00:00",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Reservation 1 created", function () {
        client.assert(response.status === 201);
    });

    client.test("Reservation 1 has folio", function () {
