###

### CREATE RESERVATION COMMENT

POST {{reservationUrl}}/{{reservation1Id}}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "text": "Гість попросив підготувати номер із видом на річку до заїзду."
}

> {%
    client.test("Comment created", function () {
        client.assert(response.status === 201);
    });

    client.test("Comment text is correct", function () {
        client.assert(response.body.text === "Гість попросив підготувати номер із видом на річку до заїзду.");
    });

    client.test("Comment has id", function () {
        client.assert(response.body.id !== null && response.body.id !== undefined);
    });

    client.test("Comment has reservation id", function () {
        client.assert(response.body.reservationId == client.global.get("reservation1Id"));
    });

    client.test("Comment has createdAt", function () {
        client.assert(response.body.createdAt !== null && response.body.createdAt !== undefined);
    });

    client.global.set("reservationCommentId", response.body.id);
%}

###

### UPDATE RESERVATION COMMENT

