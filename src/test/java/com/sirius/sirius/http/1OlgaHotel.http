  "roomId": {{room1Id}},
  "rateId": {{standardRateId}},
  "paymentCategoryId": {{standardCategoryId}},
  "primaryGuestId": {{profile1Id}},
  "guestIds": [{{profile1Id}}, {{profile2Id}}],
  "checkIn": "{{reservation1CheckInDate}}T14:00:00",
  "checkOut": "{{reservation1CheckOutDate}}T12:00:00",
  "adults": 2,
  "children": 0,
  "taxStatus": "RESIDENT",
  "bookingSource": "HTTP_TEST",
