### BAR

POST {{rateUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "BAR",
  "description": "Best Available Rate",
  "currency": "UAH",
  "categoryId": {{standardCategoryId}},
  "price": 5000.00,
  "active": true
}

> {%
    client.test("BAR rate created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("barRateId", response.body.id);
%}

