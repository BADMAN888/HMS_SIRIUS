@baseUrl = http://localhost:8080

@hotelUrl = {{baseUrl}}/api/hotels
@roomCategoryUrl = {{baseUrl}}/api/room-category
@roomUrl = {{baseUrl}}/api/rooms
@rateUrl = {{baseUrl}}/api/rates
@priceUrl = {{baseUrl}}/api/prices
@profileUrl = {{baseUrl}}/api/profiles
@reservationUrl = {{baseUrl}}/api/reservations
@folioUrl = {{baseUrl}}/api/folios
@accrualUrl = {{baseUrl}}/api/accruals
@paymentUrl = {{baseUrl}}/api/payments
@hotelGridUrl = {{baseUrl}}/api/hotel-grid

### AUTH

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200);
    });

    const token = response.body.accessToken ?? response.body.token;

    client.test("Access token exists", function () {
        client.assert(token !== null && token !== undefined);
    });

    client.global.set("token", token);
%}

###

### CREATE HOTEL

POST {{hotelUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "Sirius Riverside Hotel",
  "description": "Modern riverside hotel in Kozyn",
  "phone": "+380671112233",
  "email": "sirius.riverside.hotel@gmail.com",
  "address": "Kozyn, Kyiv Oblast",
  "checkInTime": "14:00:00",
  "checkOutTime": "12:00:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 201);
    });

    client.test("Hotel id exists", function () {
        client.assert(response.body.id !== null && response.body.id !== undefined);
    });

    client.global.set("hotelId", response.body.id);
%}

###

### GET HOTEL BY ID

GET {{hotelUrl}}/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel loaded", function () {
        client.assert(response.status === 200);
    });

    client.test("Correct hotel returned", function () {
        client.assert(response.body.id == client.global.get("hotelId"));
    });
%}

###

### GET HOTEL BY NAME

GET {{hotelUrl}}/by-name?name=Sirius%20Riverside%20Hotel
Authorization: Bearer {{token}}

> {%
    client.test("Hotel found by name", function () {
        client.assert(response.status === 200);
    });

    client.test("Hotel name is correct", function () {
        client.assert(response.body.hotelName === "Sirius Riverside Hotel");
    });
%}

