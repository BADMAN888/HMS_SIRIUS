
@baseUrl = http://localhost:8080

# Select the "local" HTTP Client environment to load credentials from the private env file.

@hotelUrl = {{baseUrl}}/api/hotels
@roomCategoryUrl = {{baseUrl}}/api/room-category
@roomUrl = {{baseUrl}}/api/rooms
@rateUrl = {{baseUrl}}/api/rates
@serviceComponentUrl = {{baseUrl}}/api/service-components
@priceUrl = {{baseUrl}}/api/prices
@profileUrl = {{baseUrl}}/api/profiles
@guestDocumentUrl = {{baseUrl}}/api/guest-documents
@companyUrl = {{baseUrl}}/api/companies
@legalEntityUrl = {{baseUrl}}/api/legal-entities
@facilityUrl = {{baseUrl}}/api/facilities
@facilityPriceUrl = {{baseUrl}}/api/facility-prices
@reservationUrl = {{baseUrl}}/api/reservations
@folioUrl = {{baseUrl}}/api/folios
@accrualUrl = {{baseUrl}}/api/accruals
@paymentUrl = {{baseUrl}}/api/payments
@balanceAccountUrl = {{baseUrl}}/api/balance-accounts
@correctionUrl = {{baseUrl}}/api/reservation-financial-corrections
@hotelGridUrl = {{baseUrl}}/api/hotel-grid
@cashRegisterUrl = {{baseUrl}}/api/cash-registers
@cashOperationsUrl = {{baseUrl}}/api/cash-operations
@cashOperationsReportUrl = {{baseUrl}}/api/cash-reports/operations

### ==================================================
### TEST CONFIGURATION
### ==================================================


### Бронювання 1
@reservation1CheckInDate = 2026-12-20
@reservation1CheckOutDate = 2026-12-23

### Бронювання 2
@reservation2CheckInDate = 2026-12-22
@reservation2CheckOutDate = 2026-12-24

### Бронювання 3
@reservation3CheckInDate = 2026-12-25
@reservation3CheckOutDate = 2026-12-27

### Додаткові бронювання для Hotel Grid
@reservation4CheckInDate = 2026-12-15
@reservation4CheckOutDate = 2026-12-18
@reservation5CheckInDate = 2026-12-17
@reservation5CheckOutDate = 2026-12-21
@reservation6CheckInDate = 2026-12-19
@reservation6CheckOutDate = 2026-12-22
@reservation7CheckInDate = 2026-12-23
@reservation7CheckOutDate = 2026-12-28
@reservation8CheckInDate = 2026-12-29
@reservation8CheckOutDate = 2027-01-03
@reservation9CheckInDate = 2027-01-02
@reservation9CheckOutDate = 2027-01-07
@reservation10CheckInDate = 2027-01-08
@reservation10CheckOutDate = 2027-01-12

@gridStartDate = 2026-12-15
@gridEndDate = 2027-01-15

### Період дії тарифів
@priceValidFrom = 2026-01-01
@priceValidTo = 2030-12-31

### ==================================================
### AUTH
### ==================================================

# Run the admin login request in AuthController.http first. It sets token and runCode.

### REFRESH TOKEN

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Token refreshed", function () {
        client.assert(response.status === 200);
        client.assert(response.body.token != null);
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### ==================================================
### HOTEL
### ==================================================

### CREATE HOTEL

POST {{hotelUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "Sirius Riverside Hotel {{runCode}}",
  "description": "End-to-end test hotel",
  "phone": "+380671112233",
  "email": "sirius.{{runCode}}@gmail.com",
  "address": "Kozyn, Kyiv Oblast, Ukraine",
  "checkInTime": "14:00:00",
  "checkOutTime": "12:00:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("hotelId", response.body.id);
%}

###

### GET HOTEL

GET {{hotelUrl}}/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel loaded", function () {
        client.assert(response.status === 200);
    });
%}

###

### GET HOTEL BY NAME

GET {{hotelUrl}}/by-name?name=Sirius%20Riverside%20Hotel%20{{runCode}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel found by name", function () {
        client.assert(response.status === 200);
    });
%}

###

### GET ALL HOTELS

GET {{hotelUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotels loaded", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body));
        client.assert(response.body.some(function (hotel) { return hotel.id === Number(client.global.get("hotelId")); }));
    });
%}

### ==================================================
### LEGAL ENTITIES
### ==================================================

### CREATE LEGAL ENTITY

POST {{legalEntityUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Sirius Test Company {{runCode}} LLC",
  "shortName": "Sirius Test {{runCode}}",
  "edrpou": "{{runCode}}",
  "registrationDate": "2020-01-15",
  "organizationalLegalForm": "LLC"
}

> {%
    client.test("Legal entity created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("legalEntityId", response.body.id);
%}

###

### CREATE SECOND LEGAL ENTITY FOR ISOLATION CHECK

POST {{legalEntityUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Sirius Second Test Company {{runCode}} LLC",
  "shortName": "Sirius Second {{runCode}}",
  "edrpou": "{{legalEntity2Code}}",
  "registrationDate": "2021-02-15",
  "organizationalLegalForm": "LLC"
}

> {%
    client.test("Second legal entity created", function () {
        client.assert(response.status === 201);
    });
    client.global.set("legalEntity2Id", response.body.id);
%}

###

### GET ALL LEGAL ENTITIES

GET {{legalEntityUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Legal entities listed", function () {
        client.assert(response.status === 200);
        client.assert(response.body.some(function (entity) { return entity.id === Number(client.global.get("legalEntityId")); }));
        client.assert(response.body.some(function (entity) { return entity.id === Number(client.global.get("legalEntity2Id")); }));
    });
%}

###

### GET LEGAL ENTITY BY ID

GET {{legalEntityUrl}}/{{legalEntityId}}
Authorization: Bearer {{token}}

> {%
    client.test("Legal entity loaded by id", function () {
        client.assert(response.status === 200);
        client.assert(response.body.id === Number(client.global.get("legalEntityId")));
    });
%}

###

### ASSOCIATE LEGAL ENTITY WITH HOTEL

PUT {{hotelUrl}}/{{hotelId}}/legal-entities
Authorization: Bearer {{token}}
Content-Type: application/json

[{{legalEntityId}}, {{legalEntity2Id}}]

> {%
    client.test("Legal entity associated with hotel", function () {
        client.assert(response.status === 200);
    });
%}

###

### GET LEGAL ENTITIES BY HOTEL

GET {{legalEntityUrl}}/hotel/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Both hotel legal entities loaded", function () {
        client.assert(response.status === 200);
        client.assert(response.body.length === 2);
    });
%}

### ==================================================
### CASH REGISTER SETUP
### ==================================================

### CREATE CASH REGISTER FOR LEGAL ENTITY 1

POST {{cashRegisterUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "legalEntityId": {{legalEntityId}},
  "name": "Основна каса {{runCode}}",
  "currency": "UAH"
}

> {%
    client.test("Cash register 1 created", function () {
        client.assert(response.status === 201);
    });
    client.global.set("cashRegisterId", response.body.id);
%}

###

### CREATE CASH REGISTER FOR LEGAL ENTITY 2

POST {{cashRegisterUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "legalEntityId": {{legalEntity2Id}},
  "name": "Друга каса {{runCode}}",
  "currency": "UAH"
}

> {%
    client.test("Cash register 2 created", function () {
        client.assert(response.status === 201);
    });
    client.global.set("cashRegister2Id", response.body.id);
%}

###

### DUPLICATE LEGAL ENTITY CASH REGISTER MUST FAIL

POST {{cashRegisterUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "legalEntityId": {{legalEntityId}},
  "name": "Duplicate cash register {{runCode}}",
  "currency": "UAH"
}

> {%
    client.test("Only one register can exist per hotel and legal entity", function () {
        client.assert(response.status === 409);
    });
%}

###

### GET CASH REGISTERS FOR HOTEL

GET {{cashRegisterUrl}}?hotelId={{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel cash registers loaded", function () {
        client.assert(response.status === 200);
        client.assert(response.body.length === 2);
    });
%}

###

### GET CASH REGISTER DETAILS

GET {{cashRegisterUrl}}/{{cashRegisterId}}
Authorization: Bearer {{token}}

> {%
    client.test("Cash register details loaded", function () {
        client.assert(response.status === 200);
        client.assert(response.body.legalEntityId === Number(client.global.get("legalEntityId")));
    });
%}

###

### OPEN SHIFT 1

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/open
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "openingBalance": 500.00
}

> {%
    client.test("Cash shift 1 opened", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status === "OPEN");
    });
    client.global.set("cashShiftId", response.body.id);
%}

###

### OPEN SHIFT 2

POST {{cashRegisterUrl}}/{{cashRegister2Id}}/shifts/open
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "openingBalance": 100.00
}

> {%
    client.test("Cash shift 2 opened", function () {
        client.assert(response.status === 200);
        client.assert(response.body.status === "OPEN");
    });
    client.global.set("cashShift2Id", response.body.id);
%}

###

### SECOND OPEN SHIFT FOR SAME REGISTER MUST FAIL

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/open
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "openingBalance": 0.00
}

> {%
    client.test("Cannot open two shifts for one register", function () {
        client.assert(response.status === 409);
    });
%}

###

### X REPORT FOR EMPTY SHIFT

GET {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/x-report
Authorization: Bearer {{token}}

> {%
    client.test("X report works for an empty open shift", function () {
        client.assert(response.status === 200);
        client.assert(response.body.reportType === "X");
        client.assert(response.body.shift.status === "OPEN");
        client.assert(response.body.operations.length === 0);
        client.assert(Number(response.body.shift.currentCash) === 500);
    });
    client.global.set("emptyXReportId", response.body.id);
%}

###

### SERVICE IN WITH REQUIRED COMMENT

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/service-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 250.00,
  "description": "Cash float replenishment"
}

> {%
    client.test("Service-in requires and stores a comment", function () {
        client.assert(response.status === 200);
        client.assert(response.body.operationType === "SERVICE_IN");
        client.assert(response.body.description === "Cash float replenishment");
    });
    client.global.set("cashServiceInId", response.body.id);
%}

###

### SERVICE OUT WITH REQUIRED COMMENT

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/service-out
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 100.00,
  "description": "Cash drawer expense"
}

> {%
    client.test("Service-out requires and stores a comment", function () {
        client.assert(response.status === 200);
        client.assert(response.body.operationType === "SERVICE_OUT");
        client.assert(response.body.description === "Cash drawer expense");
    });
    client.global.set("cashServiceOutId", response.body.id);
%}

###

### SERVICE OUT CANNOT OVERDRAW THE REGISTER

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/service-out
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 100000.00,
  "description": "Attempted overdraw test"
}

> {%
    client.test("Cash register cannot be overdrawn", function () {
        client.assert(response.status === 409);
    });
%}

###

### SERVICE IN TO SECOND LEGAL ENTITY

POST {{cashRegisterUrl}}/{{cashRegister2Id}}/shifts/{{cashShift2Id}}/service-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 50.00,
  "description": "Second legal entity opening movement"
}

> {%
    client.test("Second legal entity has separate cash movements", function () {
        client.assert(response.status === 200);
        client.assert(response.body.legalEntityId === Number(client.global.get("legalEntity2Id")));
    });
%}

