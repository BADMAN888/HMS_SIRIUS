@baseUrl = http://localhost:8080
@hotelUrl = {{baseUrl}}/api/hotels
@roomCategoryUrl = {{baseUrl}}/api/room-category
@roomUrl = {{baseUrl}}/api/rooms
@rateUrl = {{baseUrl}}/api/rates
@priceUrl = {{baseUrl}}/api/prices

### ==================================================
### 1. AUTH
### ==================================================

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Token exists", function () {
        client.assert(response.body.token !== undefined);
        client.assert(response.body.token !== null);
    });

    client.global.set("token", response.body.token);
%}

### ==================================================
### 2. HOTEL
### ==================================================

POST {{hotelUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "Olga Grand Hotel",
  "description": "Four-star hotel in Kozyn with comfortable rooms, modern facilities and professional service.",
  "phone": "+380441234567",
  "email": "info@sirius-hotel.com",
  "address": "Malyshka Street 8",
  "checkInTime": "14:00",
  "checkOutTime": "12:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 201);
    });

    client.test("Hotel id exists", function () {
        client.assert(response.body.id !== undefined);
    });

    client.global.set("hotelId", response.body.id);
%}

### ==================================================
### 3. ROOM CATEGORIES
### ==================================================

### Standard

POST {{roomCategoryUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Standard",
  "description": "Comfortable room with everything needed for a pleasant stay.",
  "countOfBeds": 2,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Standard category created", function () {
        client.assert(response.status === 201);
    });

    client.global.set("standardCategoryId", response.body.id);
%}

