### RESERVATION 1 - STANDARD

POST {{reservationUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomId": {{room101Id}},
  "rateId": {{barStandardRateId}},
  "primaryGuestId": {{profile1Id}},
  "guestIds": [
    {{profile1Id}},
    {{profile2Id}}
  ],
  "checkInDate": "2026-09-25",
  "checkOutDate": "2026-09-28",
  "adults": 2,
  "children": 0
}

> {%
    client.test("Reservation 1 created", function () {
        client.assert(response.status === 201);
    });

    client.assert(response.body.id !== null);
    client.assert(response.body.folioId !== null);

    client.global.set("reservation1Id", response.body.id);
    client.global.set("folio1Id", response.body.folioId);
%}


