###

### FILTER CASH OPERATIONS BY REGISTER

GET {{cashOperationsUrl}}?hotelId={{hotelId}}&registerId={{cashRegisterId}}
Authorization: Bearer {{token}}

> {%
    client.test("Cash operations can be filtered by register", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body));
        client.assert(response.body.every(function (item) { return item.cashRegisterId === Number(client.global.get("cashRegisterId")); }));
    });
%}

###

### OPERATIONS REPORT GROUPED BY LEGAL ENTITY

GET {{cashOperationsReportUrl}}?hotelId={{hotelId}}&from=2026-01-01T00:00:00&to=2035-01-01T00:00:00
Authorization: Bearer {{token}}

> {%
    client.test("Cash report preserves separate legal entity totals", function () {
        client.assert(response.status === 200);
        client.assert(Array.isArray(response.body.operations));
        client.assert(Array.isArray(response.body.totalsByLegalEntity));
        client.assert(response.body.totalsByLegalEntity.length === 2);
    });
%}

###

### Z REPORT CLOSES CASH SHIFT 1

POST {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/z-report
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualBalance": {{cashExpectedBalance}}
}

> {%
    client.test("Z report stores actual balance and closes shift", function () {
        client.assert(response.status === 200);
        client.assert(response.body.reportType === "Z");
        client.assert(response.body.shift.status === "CLOSED");
        client.assert(Number(response.body.shift.difference) === 0);
    });
%}

###

### OPERATIONS REMAIN READABLE AFTER Z REPORT

GET {{cashRegisterUrl}}/{{cashRegisterId}}/shifts/{{cashShiftId}}/operations
Authorization: Bearer {{token}}

> {%
    client.test("Closed shift history remains available", function () {
        client.assert(response.status === 200);
        client.assert(response.body.length >= 6);
    });
%}

