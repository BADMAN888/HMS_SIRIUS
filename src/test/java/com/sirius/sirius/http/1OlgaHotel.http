@baseUrl = http://localhost:8080

@hotelUrl = {{baseUrl}}/api/hotels
@roomCategoryUrl = {{baseUrl}}/api/room-category
@roomUrl = {{baseUrl}}/api/rooms
@rateUrl = {{baseUrl}}/api/rates
@priceUrl = {{baseUrl}}/api/prices
@profileUrl = {{baseUrl}}/api/profiles
@reservationUrl = {{baseUrl}}/api/reservations
@folioUrl = {{baseUrl}}/api/folios
@accrualUrl = {{baseUrl}}/api/accruals
@paymentUrl = {{baseUrl}}/api/payments


### AUTH

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200);
    });

    client.assert(response.body.token !== null);
    client.global.set("token", response.body.token);
%}


### HOTEL

POST {{hotelUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "Olga Grand Hotel",
  "description": "Luxury hotel in Kozyn",
  "phone": "+380501234567",
  "email": "olga.grand.hotel@gmail.com",
  "address": "Kozyn, Kyiv Region",
  "checkInTime": "14:00:00",
  "checkOutTime": "12:00:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 201);
    });

    client.assert(response.body.id !== null);
    client.global.set("hotelId", response.body.id);
%}


### HOTEL BY ID

GET {{hotelUrl}}/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Hotel found", function () {
        client.assert(response.status === 200);
    });

    client.assert(response.body.id == client.global.get("hotelId"));
%}


### HOTEL BY NAME

GET {{hotelUrl}}/by-name?name=Olga%20Grand%20Hotel
Authorization: Bearer {{token}}

> {%
    client.test("Hotel found by name", function () {
        client.assert(response.status === 200);
    });

    client.assert(response.body.hotelName === "Olga Grand Hotel");
%}


