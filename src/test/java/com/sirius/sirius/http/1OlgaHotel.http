###

### CASH PAYMENT WITH IDEMPOTENCY KEY

POST {{paymentUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "folioId": {{folio2Id}},
  "method": "CASH",
  "amount": 1.00,
  "description": "Cash journal integration test",
  "idempotencyKey": "cash-payment-{{runCode}}"
}

> {%
    client.test("Cash payment created and journaled", function () {
        client.assert(response.status === 201);
        client.assert(response.body.amount === 1 || response.body.amount === 1.0);
    });
    client.global.set("cashPaymentId", response.body.id);
%}

###

### REPEAT CASH PAYMENT REQUEST MUST NOT DUPLICATE

POST {{paymentUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "folioId": {{folio2Id}},
  "method": "CASH",
  "amount": 1.00,
  "description": "Cash journal integration test",
  "idempotencyKey": "cash-payment-{{runCode}}"
}

> {%
    client.test("Repeated payment returns the original payment", function () {
        client.assert(response.status === 201);
        client.assert(response.body.id === Number(client.global.get("cashPaymentId")));
    });
%}

