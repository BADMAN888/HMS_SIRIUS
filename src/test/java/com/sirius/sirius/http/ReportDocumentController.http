@baseUrl = http://localhost:8080
@hotelId = {{createdHotelId}}

### Generate report document
POST {{baseUrl}}/api/reports/documents?format=PDF
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "hotelName": "HTTP Test Hotel",
  "title": "HTTP Test Report",
  "fromDate": "2026-11-01",
  "toDate": "2026-11-30",
  "columns": ["Reservation", "Guest"],
  "rows": [["HTTP-001", "Test Guest"]]
}

### Preview report document
POST {{baseUrl}}/api/reports/documents/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "hotelName": "HTTP Test Hotel",
  "title": "HTTP Test Report Preview",
  "fromDate": "2026-11-01",
  "toDate": "2026-11-30",
  "columns": ["Reservation", "Guest"],
  "rows": [["HTTP-001", "Test Guest"]]
}
