### ========================================
### UPDATE ROOM
### ========================================

PUT {{roomUrl}}/{{testRoomId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomNumber": "HTTP-UPDATED-101",
  "floor": 10,
  "status": "AVAILABLE",
  "roomView": "PANORAMIC",
  "hotelId": 1,
  "categoryId": 1
}

> {%
    client.test("Update room returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Updated room number is correct", function () {
        client.assert(response.body.roomNumber === "HTTP-UPDATED-101");
    });

    client.test("Updated room view is correct", function () {
        client.assert(response.body.roomView === "PANORAMIC");
    });
%}


