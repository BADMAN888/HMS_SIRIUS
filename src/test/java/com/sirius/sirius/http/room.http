@baseUrl = http://localhost:8080
@roomUrl = {{baseUrl}}/api/rooms

@hotelId = 1
@categoryId = 1
@testRoomId = 1
@notFoundId = 999999


### ========================================
### LOGIN
### ========================================

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("JWT token exists", function () {
        client.assert(response.body.token !== undefined);
        client.assert(response.body.token !== null);
    });

    client.global.set("token", response.body.token);
%}


### ========================================
### GET ALL ROOMS
### ========================================

GET {{roomUrl}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get all rooms returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is an array", function () {
        client.assert(Array.isArray(response.body));
    });
%}


### ========================================
### GET ROOM BY ID
### ========================================

GET {{roomUrl}}/{{testRoomId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get room by id returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Room id is correct", function () {
        client.assert(response.body.id === 1);
    });
%}


### ========================================
### GET ROOM BY NON-EXISTENT ID
### ========================================

GET {{roomUrl}}/{{notFoundId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get non-existent room returns 404", function () {
        client.assert(response.status === 404);
    });
%}


### ========================================
### GET ROOMS BY HOTEL
### ========================================

GET {{roomUrl}}/hotel/{{hotelId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get rooms by hotel returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is an array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("All rooms belong to hotel 1", function () {
        response.body.forEach(function (room) {
            client.assert(room.hotelId === 1);
        });
    });
%}


### ========================================
### GET ROOMS BY NON-EXISTENT HOTEL
### ========================================

GET {{roomUrl}}/hotel/{{notFoundId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get rooms by non-existent hotel returns 404", function () {
        client.assert(response.status === 404);
    });
%}


### ========================================
### GET ROOMS BY CATEGORY
### ========================================

GET {{roomUrl}}/category/{{categoryId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get rooms by category returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is an array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("All rooms belong to category 1", function () {
        response.body.forEach(function (room) {
            client.assert(room.categoryId === 1);
        });
    });
%}


### ========================================
### GET ROOMS BY NON-EXISTENT CATEGORY
### ========================================

GET {{roomUrl}}/category/{{notFoundId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get rooms by non-existent category returns 404", function () {
        client.assert(response.status === 404);
    });
%}


### ========================================
### GET AVAILABLE ROOMS
### ========================================

GET {{roomUrl}}/hotel/{{hotelId}}/status/AVAILABLE
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get available rooms returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is an array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("All rooms are AVAILABLE", function () {
        response.body.forEach(function (room) {
            client.assert(room.status === "AVAILABLE");
        });
    });
%}


### ========================================
### GET OCCUPIED ROOMS
### ========================================

GET {{roomUrl}}/hotel/{{hotelId}}/status/OCCUPIED
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get occupied rooms returns 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Response is an array", function () {
        client.assert(Array.isArray(response.body));
    });

    client.test("All rooms are OCCUPIED", function () {
        response.body.forEach(function (room) {
            client.assert(room.status === "OCCUPIED");
        });
    });
%}


### ========================================
### GET ROOMS BY STATUS AND NON-EXISTENT HOTEL
### ========================================

GET {{roomUrl}}/hotel/{{notFoundId}}/status/AVAILABLE
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("Get status rooms for non-existent hotel returns 404", function () {
        client.assert(response.status === 404);
    });
%}


### ========================================
### CREATE ROOM
### ========================================

POST {{roomUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomNumber": "HTTP-101",
  "floor": 10,
  "status": "AVAILABLE",
  "roomView": "CITY",
  "hotelId": 1,
  "categoryId": 1
}

> {%
    client.test("Create room returns 201", function () {
        client.assert(response.status === 201);
    });

    client.test("Created room has id", function () {
        client.assert(response.body.id !== undefined);
    });

    client.test("Created room number is correct", function () {
        client.assert(response.body.roomNumber === "HTTP-101");
    });

    client.global.set("createdRoomId", response.body.id);
%}


### ========================================
### CREATE DUPLICATE ROOM
### ========================================

POST {{roomUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roomNumber": "HTTP-101",
  "floor": 10,
  "status": "AVAILABLE",
  "roomView": "CITY",
  "hotelId": 1,
  "categoryId": 1
}

> {%
    client.test("Duplicate room returns 400", function () {
        client.assert(response.status === 400);
    });
%}


