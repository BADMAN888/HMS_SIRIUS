
@baseUrl = http://localhost:8080

@hotelId = {{createdHotelId}}
@reservationId = {{createdReservationId}}
@profileId = {{createdProfileId}}
@folioId = {{createdFolioId}}
@accrualId = {{createdAccrualId}}

### 1. CREATE FOLIO

POST {{baseUrl}}/api/folios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelId": {{hotelId}},
  "reservationId": {{reservationId}},
  "recipientId": {{profileId}},
  "payerId": {{profileId}}
}

> {%
    client.test("Folio created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Folio ID is missing");
    });

    client.global.set("createdFolioId", response.body.id);
%}

###

### 2. GET ALL FOLIOS

GET {{baseUrl}}/api/folios
Authorization: Bearer {{token}}

###

### 3. GET FOLIO BY ID

GET {{baseUrl}}/api/folios/{{folioId}}
Authorization: Bearer {{token}}

###

### 4. GET FOLIOS BY RESERVATION

GET {{baseUrl}}/api/folios/reservation/{{reservationId}}
Authorization: Bearer {{token}}

###

### 5. GET FOLIOS BY HOTEL

GET {{baseUrl}}/api/folios/hotel/{{hotelId}}
Authorization: Bearer {{token}}

###

### 6. ATTACH ACCRUALS TO FOLIO

PUT {{baseUrl}}/api/folios/{{folioId}}/accruals
Authorization: Bearer {{token}}
Content-Type: application/json

[
  {{accrualId}}
]

###

### 7. CLOSE FOLIO

PATCH {{baseUrl}}/api/folios/{{folioId}}/close
Authorization: Bearer {{token}}

###

### 8. REOPEN FOLIO

PATCH {{baseUrl}}/api/folios/{{folioId}}/reopen
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Reopening folio for HTTP API testing"
}

###

### 9. DELETE FOLIO

DELETE {{baseUrl}}/api/folios/{{folioId}}
Authorization: Bearer {{token}}
