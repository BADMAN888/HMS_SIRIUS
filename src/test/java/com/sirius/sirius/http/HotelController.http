
@baseUrl = http://localhost:8080
@hotelId = {{createdHotelId}}

### 1. CREATE HOTEL

POST {{baseUrl}}/api/hotels
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "HTTP Test Hotel",
  "description": "Hotel created for API testing",
  "phone": "+380501234567",
  "email": "http-test@example.com",
  "address": "Kyiv, Ukraine",
  "checkInTime": "14:00:00",
  "checkOutTime": "12:00:00"
}

> {%
    client.test("Hotel created", function () {
        client.assert(response.status === 200 || response.status === 201, "Expected HTTP 200 or 201");
        client.assert(response.body.id != null, "Hotel ID is missing");
    });

    client.global.set("createdHotelId", response.body.id);
%}

###

### 2. GET HOTEL BY ID

GET {{baseUrl}}/api/hotels/{{hotelId}}
Authorization: Bearer {{token}}

###

### 3. GET HOTEL BY NAME

GET {{baseUrl}}/api/hotels/by-name?name=HTTP%20Test%20Hotel
Authorization: Bearer {{token}}

###

### 4. UPDATE HOTEL

PUT {{baseUrl}}/api/hotels/{{hotelId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hotelName": "HTTP Test Hotel Updated",
  "description": "Updated hotel description",
  "phone": "+380509876543",
  "email": "http-test-updated@example.com",
  "address": "Kozyn, Ukraine",
  "checkInTime": "15:00:00",
  "checkOutTime": "11:00:00"
}

###

### 5. GET UPDATED HOTEL

GET {{baseUrl}}/api/hotels/{{hotelId}}
Authorization: Bearer {{token}}
