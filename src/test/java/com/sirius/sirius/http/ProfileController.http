@baseUrl = http://localhost:8080
@profileUrl = {{baseUrl}}/api/profiles


### ========================================
### LOGIN
### ========================================

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });

    client.global.set("token", response.body.token);
%}


### ========================================
### CREATE PROFILE
### ========================================

POST {{profileUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Smith",
  "middleName": "Michael",
  "dateOfBirth": "1990-05-15",
  "gender": "MALE",
  "email": "john.smith@gmail.com",
  "phone": "+380991234567"
}

> {%
    test("Status is 201", function() {
        expect(response.status).to.equal(201);
    });

    client.global.set("profileId", response.body.id);
%}


### ========================================
### GET ALL PROFILES
### ========================================

GET {{profileUrl}}
Authorization: Bearer {{token}}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });
%}


### ========================================
### GET PROFILE BY ID
### ========================================

GET {{profileUrl}}/{{profileId}}
Authorization: Bearer {{token}}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });
%}


### ========================================
### UPDATE PROFILE
### ========================================

PUT {{profileUrl}}/{{profileId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Smith",
  "middleName": "Andrew",
  "dateOfBirth": "1990-05-15",
  "gender": "MALE",
  "email": "john.updated@gmail.com",
  "phone": "+380991234568"
}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });
%}


### ========================================
### GET UPDATED PROFILE
### ========================================

GET {{profileUrl}}/{{profileId}}
Authorization: Bearer {{token}}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });
%}


### ========================================
### DELETE PROFILE
### ========================================

DELETE {{profileUrl}}/{{profileId}}
Authorization: Bearer {{token}}

> {%
    test("Status is 200", function() {
        expect(response.status).to.equal(200);
    });
%}


### ========================================
### GET DELETED PROFILE
### ========================================

GET {{profileUrl}}/{{profileId}}
Authorization: Bearer {{token}}

> {%
    test("Status is 404", function() {
        expect(response.status).to.equal(404);
    });
%}