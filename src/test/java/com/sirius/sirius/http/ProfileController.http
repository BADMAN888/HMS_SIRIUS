
@baseUrl = http://localhost:8080
@profileId = {{createdProfileId}}

### 1. CREATE PROFILE

POST {{baseUrl}}/api/profiles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "HTTP",
  "lastName": "Test",
  "middleName": "Profile",
  "phoneNumber": "+380991234567",
  "email": "http.profile@sirius.com",
  "gender": "MALE",
  "address": "Kyiv, Ukraine"
}

> {%
    client.test("Profile created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Profile ID is missing");
        client.assert(response.body.firstName === "HTTP", "Incorrect first name");
    });

    client.global.set("createdProfileId", response.body.id);
%}

###

### 2. GET ALL PROFILES

GET {{baseUrl}}/api/profiles
Authorization: Bearer {{token}}

> {%
    client.test("Profiles retrieved", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected an array");
    });
%}

###

### 3. GET PROFILE BY ID

GET {{baseUrl}}/api/profiles/{{profileId}}
Authorization: Bearer {{token}}

> {%
    client.test("Profile retrieved by ID", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.id != null, "Profile ID is missing");
    });
%}

###

### 4. UPDATE PROFILE

PUT {{baseUrl}}/api/profiles/{{profileId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "HTTP Updated",
  "lastName": "Test",
  "middleName": "Profile",
  "phoneNumber": "+380991234567",
  "email": "http.profile@sirius.com",
  "gender": "MALE",
  "address": "Updated address, Kyiv"
}

> {%
    client.test("Profile updated", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.firstName === "HTTP Updated", "First name was not updated");
        client.assert(response.body.address === "Updated address, Kyiv", "Address was not updated");
    });
%}

###

### 5. GET PROFILE RESERVATIONS

GET {{baseUrl}}/api/profiles/2/reservations
Authorization: Bearer {{token}}

> {%
    client.test("Profile reservations retrieved", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected an array");

        if (response.body.length > 0) {
            const reservation = response.body[0];

            client.assert(reservation.confirmationNumber != null, "Reservation number is missing");
            client.assert(reservation.checkIn != null, "Check-in is missing");
            client.assert(reservation.checkOut != null, "Check-out is missing");
            client.assert(reservation.roomCategory != null, "Room category is missing");
            client.assert(reservation.roomNumber != null, "Room number is missing");
            client.assert(reservation.rateName != null, "Rate is missing");
        }
    });
%}

###

### 6. DELETE PROFILE

DELETE {{baseUrl}}/api/profiles/{{profileId}}
Authorization: Bearer {{token}}

> {%
    client.test("Profile deleted", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    client.global.clear("createdProfileId");
%}
