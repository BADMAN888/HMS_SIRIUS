
@baseUrl = http://localhost:8080
@companyId = {{createdCompanyId}}

### 1. CREATE COMPANY

POST {{baseUrl}}/api/companies
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "HTTP Test Company LLC",
  "shortName": "HTTP Test Company",
  "edrpou": "12345678",
  "registrationDate": "2020-01-15",
  "organizationalLegalForm": "LLC"
}

> {%
    client.test("Company created", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Company ID is missing");
    });

    client.global.set("createdCompanyId", response.body.id);
%}

###

### 2. GET ALL COMPANIES

GET {{baseUrl}}/api/companies
Authorization: Bearer {{token}}

###

### 3. GET COMPANY BY ID

GET {{baseUrl}}/api/companies/{{companyId}}
Authorization: Bearer {{token}}

###

### 4. UPDATE COMPANY

PUT {{baseUrl}}/api/companies/{{companyId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "HTTP Test Company Updated LLC",
  "shortName": "HTTP Test Updated",
  "edrpou": "12345678",
  "registrationDate": "2020-01-15",
  "organizationalLegalForm": "LLC"
}

###

### 5. DEACTIVATE COMPANY

PATCH {{baseUrl}}/api/companies/{{companyId}}/deactivate
Authorization: Bearer {{token}}
