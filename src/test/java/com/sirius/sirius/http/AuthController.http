@baseUrl = http://localhost:8080

# Локальні значення для HTTP-запитів. Не коміть реальні паролі у Git.
@adminEmail = vlad20020502@gmail.com
@adminPassword = Kovalenko20020502
@newUserEmail = new.employee@example.com
@newUserPassword = ChangeThisUserPassword123!
@newUserName = HTTP Test Employee

### 1. Увійти як адміністратор

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("Admin login successful", function () {
        client.assert(response.status === 200, "Перевір adminEmail і adminPassword на початку файлу");
        client.assert(response.body.token != null, "Access token відсутній");
        client.assert(response.body.refreshToken != null, "Refresh token відсутній");
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
    client.global.set("adminToken", response.body.token);
    var runCode = String(10000000 + (Date.now() % 90000000));
    client.global.set("runCode", runCode);
    client.global.set("legalEntity2Code", String(10000000 + ((Number(runCode) - 10000000 + 1) % 90000000)));
%}

### 2. Знайти готель для нового користувача

GET {{baseUrl}}/api/hotels
Authorization: Bearer {{adminToken}}

> {%
    client.test("Hotel available for new user", function () {
        client.assert(response.status === 200, "Не вдалося отримати список готелів");
        client.assert(Array.isArray(response.body) && response.body.length > 0, "Спочатку створи готель через 1OlgaHotel.http");
    });

    client.global.set("hotelId", response.body[0].id);
%}

### 3. Створити користувача готелю

POST {{baseUrl}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "{{newUserName}}",
  "email": "{{newUserEmail}}",
  "password": "{{newUserPassword}}",
  "hotelId": {{hotelId}}
}

> {%
    client.test("Hotel user created", function () {
        client.assert(response.status === 201, "Переконайся, що hotelId існує і вхід виконано адміном");
        client.assert(response.body.email != null, "Email користувача відсутній у відповіді");
        client.assert(response.body.fullName === "{{newUserName}}", "Ім’я користувача відсутнє");
        client.assert(response.body.role === "USER");
        client.assert(response.body.hotelId != null, "Готель не призначено користувачу");
    });
%}
