@baseUrl = http://localhost:8080

### Потрібні змінні HTTP Client environment: adminEmail, adminPassword, hotelId

### 1. Самостійна реєстрація вимкнена

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "self-registration@example.com",
  "password": "TestPassword123!"
}

> {%
    client.test("Self-registration is disabled", function () {
        client.assert(response.status === 403, "Expected HTTP 403 when self-registration is disabled");
        client.assert(response.body.message === "Самостійну реєстрацію вимкнено; обліковий запис створює адміністратор готелю");
    });
%}

### 2. Вхід адміністратора

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("Admin login successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token != null, "Token is missing");
        client.assert(response.body.refreshToken != null, "Refresh token is missing");
    });

    client.global.set("adminToken", response.body.token);
    client.global.set("adminRefreshToken", response.body.refreshToken);
    var suffix = String(Date.now());
    client.global.set("createdUserEmail", "http-user-" + suffix + "@example.com");
    client.global.set("createdUserPassword", "HttpTest-" + suffix + "-Pass!");
%}

### 3. Адміністратор створює акаунт користувача готелю

POST {{baseUrl}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{createdUserEmail}}",
  "password": "{{createdUserPassword}}",
  "hotelId": {{hotelId}}
}

> {%
    client.test("Hotel user created by administrator", function () {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.email === client.global.get("createdUserEmail"));
        client.assert(response.body.role === "USER");
        client.assert(response.body.hotelId != null, "Hotel assignment is missing");
    });
%}

### 4. Вхід створеного користувача

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{createdUserEmail}}",
  "password": "{{createdUserPassword}}"
}

> {%
    client.test("Hotel user login successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token != null, "Token is missing");
        client.assert(response.body.refreshToken != null, "Refresh token is missing");
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
%}

### 5. Оновлення токенів

POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    client.test("Token refresh successful", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token != null, "Token is missing");
        client.assert(response.body.refreshToken != null, "Refresh token is missing");
    });

    client.global.set("token", response.body.token);
    client.global.set("refreshToken", response.body.refreshToken);
%}
