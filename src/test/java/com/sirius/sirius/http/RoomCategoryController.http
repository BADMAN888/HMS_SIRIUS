
@baseUrl = http://localhost:8080
@hotelId = {{createdHotelId}}
@categoryId = {{createdCategoryId}}

### 1. CREATE ROOM CATEGORY

POST {{baseUrl}}/api/room-category
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Test Category",
  "description": "Category created for API testing",
  "countOfBeds": 2,
  "hotelId": "{{hotelId}}"
}

> {%
    client.global.set("createdCategoryId", response.body.id);
%}

###

### 2. GET ALL ROOM CATEGORIES

GET {{baseUrl}}/api/room-category
Authorization: Bearer {{token}}

###

### 3. GET ROOM CATEGORY BY ID

GET {{baseUrl}}/api/room-category/{{categoryId}}
Authorization: Bearer {{token}}

###

### 4. GET ROOM CATEGORIES BY HOTEL

GET {{baseUrl}}/api/room-category/by-hotel/{{hotelId}}
Authorization: Bearer {{token}}

###

### 5. UPDATE ROOM CATEGORY

PUT {{baseUrl}}/api/room-category/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Test Category Updated",
  "description": "Updated category description",
  "countOfBeds": 3,
  "hotelId": "{{hotelId}}"
}
