@baseUrl = http://localhost:8080
@roomCategoryUrl = {{baseUrl}}/api/room-category
@hotelId = 1
@categoryId = 1
@notFoundId = 999999


### =========================
### AUTH
### =========================

### LOGIN
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@gmail.com",
  "password": "123456"
}

> {%
    client.test("Login - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Login - token exists", function() {
        client.assert(
            response.body.token !== undefined,
            "Expected JWT token"
        );
    });

    client.global.set("token", response.body.token);
%}


### =========================
### GET
### =========================

### GET ROOM CATEGORY BY ID
GET {{roomCategoryUrl}}/{{categoryId}}
Authorization: Bearer {{token}}

### GET ROOM CATEGORY - NOT FOUND
GET {{roomCategoryUrl}}/{{notFoundId}}
Authorization: Bearer {{token}}

> {%
    client.test("Get non-existing category - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### GET ALL ROOM CATEGORIES
GET {{roomCategoryUrl}}
Authorization: Bearer {{token}}

> {%
    client.test("Get all categories - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Response is array", function() {
        client.assert(
            Array.isArray(response.body),
            "Expected array"
        );
    });
%}


### GET ROOM CATEGORIES BY HOTEL
GET {{roomCategoryUrl}}/by-hotel/{{hotelId}}
Authorization: Bearer {{token}}

> {%
    client.test("Get categories by hotel - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Response is array", function() {
        client.assert(
            Array.isArray(response.body),
            "Expected array"
        );
    });

    client.test("All categories belong to hotel", function() {
        client.assert(
            response.body.every(category => category.hotelId === 1),
            "Expected all categories to belong to hotel 1"
        );
    });
%}


### GET ROOM CATEGORIES BY NON-EXISTING HOTEL
GET {{roomCategoryUrl}}/by-hotel/{{notFoundId}}
Authorization: Bearer {{token}}

> {%
    client.test("Get categories by non-existing hotel - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### =========================
### POST
### =========================

### CREATE ROOM CATEGORY
POST {{roomCategoryUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP xe",
  "description": "Large room created by HTTP test",
  "countOfBeds": 2,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Create category - status 201", function() {
        client.assert(response.status === 201, "Expected status 201");
    });

    client.test("Created category has id", function() {
        client.assert(
            response.body.id !== undefined,
            "Expected category id"
        );
    });

    client.test("Created category has correct name", function() {
        client.assert(
            response.body.name === "HTTP Deluxe",
            "Expected name HTTP Deluxe"
        );
    });

    client.test("Created category has correct hotel", function() {
        client.assert(
            response.body.hotelId === 1,
            "Expected hotelId 1"
        );
    });

    client.global.set("createdCategoryId", response.body.id);
%}


### CREATE DUPLICATE ROOM CATEGORY
POST {{roomCategoryUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Deluxe",
  "description": "Duplicate category",
  "countOfBeds": 2,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Duplicate category - status 400", function() {
        client.assert(response.status === 400, "Expected status 400");
    });
%}


### CREATE ROOM CATEGORY - INVALID DATA
POST {{roomCategoryUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "description": "Invalid category",
  "countOfBeds": 0,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Invalid category - status 400", function() {
        client.assert(response.status === 400, "Expected status 400");
    });
%}


### CREATE ROOM CATEGORY - HOTEL NOT FOUND
POST {{roomCategoryUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Invalid Hotel",
  "description": "Hotel does not exist",
  "countOfBeds": 2,
  "hotelId": {{notFoundId}}
}

> {%
    client.test("Non-existing hotel - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### =========================
### PUT
### =========================

### UPDATE ROOM CATEGORY
PUT {{roomCategoryUrl}}/{{createdCategoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "HTTP Deluxe Updated",
  "description": "Updated room category",
  "countOfBeds": 3,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Update category - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Category name was updated", function() {
        client.assert(
            response.body.name === "HTTP Deluxe Updated",
            "Expected updated name"
        );
    });

    client.test("Category beds were updated", function() {
        client.assert(
            response.body.countOfBeds === 3,
            "Expected countOfBeds 3"
        );
    });

    client.test("Category hotel was preserved", function() {
        client.assert(
            response.body.hotelId === 1,
            "Expected hotelId 1"
        );
    });
%}


### UPDATE ROOM CATEGORY - NOT FOUND
PUT {{roomCategoryUrl}}/{{notFoundId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Not Found Category",
  "description": "Category does not exist",
  "countOfBeds": 2,
  "hotelId": {{hotelId}}
}

> {%
    client.test("Update non-existing category - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### UPDATE ROOM CATEGORY - HOTEL NOT FOUND
PUT {{roomCategoryUrl}}/{{createdCategoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Invalid Hotel Category",
  "description": "Hotel does not exist",
  "countOfBeds": 2,
  "hotelId": {{notFoundId}}
}

> {%
    client.test("Update with non-existing hotel - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### =========================
### DELETE
### =========================

### DELETE CREATED ROOM CATEGORY
DELETE {{roomCategoryUrl}}/{{createdCategoryId}}
Authorization: Bearer {{token}}

> {%
    client.test("Delete category - status 200", function() {
        client.assert(response.status === 200, "Expected status 200");
    });
%}


### GET DELETED ROOM CATEGORY
GET {{roomCategoryUrl}}/{{createdCategoryId}}
Authorization: Bearer {{token}}

> {%
    client.test("Get deleted category - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}


### DELETE ROOM CATEGORY - NOT FOUND
DELETE {{roomCategoryUrl}}/{{notFoundId}}
Authorization: Bearer {{token}}

> {%
    client.test("Delete non-existing category - status 404", function() {
        client.assert(response.status === 404, "Expected status 404");
    });
%}